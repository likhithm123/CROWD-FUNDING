# PostgreSQL
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/crowdfunding_db
# Set to true when your database host requires SSL (most cloud providers).
PGSSL=false

# API server
PORT=5001
# Comma-separated list of allowed browser origins. Leave unset in development.
# CORS_ORIGIN=https://your-domain.example

# First administrator. Created on startup only if no admin exists yet.
# The password must meet the same rules as everyone else's:
# 8–64 characters with an uppercase letter, lowercase letter, number and symbol,
# and must not contain the name or the part of the email before the @.
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Frontend currency (ISO code). Defaults to INR.
# VITE_CURRENCY=INR

# AI Assistant (optional). When set, answers are generated by the LLM using live account data.
# Supported providers: Gemini (GEMINI_API_KEY), Anthropic (ANTHROPIC_API_KEY), OpenAI (OPENAI_API_KEY).
# If unset, the built-in conversational assistant engine answers naturally.
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
